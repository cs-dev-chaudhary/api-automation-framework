# api/api_client.py
import jsonschema
import requests
from config.config  import Config
from config.logger  import get_logger

logger = get_logger("APIClient")


class APIClient:

    def __init__(self):
        self.base_url = Config.BASE_URL
        self.timeout  = Config.TIMEOUT
        self.headers  = Config.HEADERS.copy()
        logger.info(f"APIClient created → base_url: {self.base_url}")

    def _make_request(self, method, endpoint, body=None, params=None):
        url = f"{self.base_url}{endpoint}"

        # ── Log the request going OUT ─────────────────────────
        logger.info(f"→ {method} {url}")
        if body:
            logger.debug(f"  body:   {body}")
        if params:
            logger.debug(f"  params: {params}")

        response = requests.request(
            method  = method,
            url     = url,
            json    = body,
            params  = params,
            headers = self.headers,
            timeout = self.timeout
        )

        # ── Log the response coming BACK ──────────────────────
        logger.info(f"← {response.status_code} ({response.elapsed.total_seconds():.2f}s)")
        if not response.ok:
            logger.warning(f"  Non-2xx response: {response.text}")

        return response

    def get(self, endpoint, params=None):
        return self._make_request("GET", endpoint, params=params)

    def post(self, endpoint, body):
        return self._make_request("POST", endpoint, body=body)

    def put(self, endpoint, body):
        return self._make_request("PUT", endpoint, body=body)

    def patch(self, endpoint, body):
        return self._make_request("PATCH", endpoint, body=body)

    def delete(self, endpoint):
        return self._make_request("DELETE", endpoint)

    # add this import at top of api_client.py


    def validate_schema(self, data, schema):
     	"""
    	Validates response data against a schema.
    	Raises AssertionError if structure doesn't match.
    	"""
    	try:
            jsonschema.validate(instance=data, schema=schema)
            logger.info("Schema validation PASSED")
    	except jsonschema.ValidationError as e:
            logger.error(f"Schema validation FAILED: {e.message}")
            raise AssertionError(f"Schema validation failed: {e.message}")
